# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Editors / local assistants
.vscode/
.idea/
.codebuddy/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*$py.class
.python-version
.venv/
venv/
env/

# Cloudflare / Wrangler local state
.wrangler/

# Build and packaging artifacts
build/
dist/
Publish.spec

# Logs and temporary files
*.log
*.tmp
*.temp

# LaTeX generated files
**/build/
**/_minted*/
*.aux
*.bbl
*.bcf
*.blg
*.fls
*.fdb_latexmk
*.listing
*.out
*.run.xml
*.synctex.gz
*.toc

# Note source policy: keep Markdown in Git, ignore all other note files.
Note/**
!Note/**/
!Note/**/*.md

# Nested Git checkouts inside notes are local dependencies, not note sources.
Note/**/third_party/darknet/
Note/**/yolov5/

# Generated PDFs are uploaded to R2, not committed with the site.
WebNote/**/pdfs/
